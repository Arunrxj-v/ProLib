# Production environment for `next build` / `npm start`.
# Loaded by Next in production only; development keeps .env.local and the
# localhost defaults. Contains public configuration only — never secrets.

# Public origin of the deployed app — its own subdomain, served from the
# root (no subpath mount). Used for metadata/share links, email verification
# links and OAuth callback derivation (Google, GitHub).
NEXT_PUBLIC_APP_URL=https://prolib.onlyme.tech
# Server-side fallback when NEXT_PUBLIC_APP_URL is unset:
APP_URL=https://prolib.onlyme.tech
# From: header for outbound email (verification links, etc.). The Resend
# API key is NOT stored here — it comes from the deployment environment.
EMAIL_FROM="ProLib <noreply@onlyme.tech>"
