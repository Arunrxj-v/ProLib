# Production environment for `next build` / `node server.js` (npm start).
# Loaded by Next in production only; development keeps .env.local and the
# localhost defaults. Contains public URLs only — never secrets.

# Public origin of the deployed app, including the /prolib mount.
# Used for metadata/share links, email verification links and OAuth
# callback derivation (Google, GitHub).
NEXT_PUBLIC_APP_URL=https://server.tailda589d.ts.net/prolib
# Server-side fallback when NEXT_PUBLIC_APP_URL is unset:
APP_URL=https://server.tailda589d.ts.net/prolib
