# ProLib environment variables — copy to `.env.local` and fill in.
# Only names the code actually reads are listed here. Blank = feature off;
# ProLib surfaces an honest "not configured" state instead of faking it.

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Local default matches docker-compose.yml (`db` service):
#   postgres://prolib:prolib@127.0.0.1:5432/prolib
# Apply schema with an explicit step — never at app boot:
#   npm run db:migrate
DATABASE_URL=

# ── Session security ─────────────────────────────────────────────────────
# Required in production (the app refuses to start without it).
# Development falls back to a fixed local-only secret.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# ── Google sign-in (primary; button hides when unset) ────────────────────
# Authorized redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback URL (otherwise derived from the request origin):
GOOGLE_CALLBACK_URL=

# ── GitHub OAuth (identity linking + real repository picker) ─────────────
# Create an OAuth App: https://github.com/settings/developers
# Authorization callback URL to register: {NEXT_PUBLIC_APP_URL}/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional explicit callback URL (otherwise derived from the request origin):
GITHUB_CALLBACK_URL=

# ── Outbound email via Resend (verification links, etc.) ─────────────────
# Without a key, development prints the link to the server console and
# production honestly reports that nothing was sent.
RESEND_API_KEY=
# Optional From: header (defaults to "ProLib <no-reply@prolib.edu>").
EMAIL_FROM=

# ── Absolute origins (metadata, mail links, API base) ────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fallback when NEXT_PUBLIC_APP_URL is unset:
APP_URL=
# Aliases used by server-side absolute URL helpers:
API_URL=
FRONTEND_URL=

# ── Upload storage (defaults shown; the directory is git-ignored) ────────
# Persistent upload root for covers/avatars/gallery (default ./storage).
# STORAGE_PATH is an accepted alias of STORAGE_DIR.
STORAGE_DIR=
